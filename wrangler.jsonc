{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buttoncounter",
  "compatibility_date": "2026-08-31",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
